<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Workspace.app's Info.plist. A program with an Info.plist IS a bundle, and this one is what the launch path
  and `libagora-launchservices` read: the identifier a window's `set_app_id` is grouped by, and the name the
  Dock and the menu bar would show. The document types Workspace ITSELF opens (a folder, a volume) are a later
  stage's; W0 declares only that it is an application.

  **THE IDENTIFIER IS THE PROJECT'S CONVENTION** (`README.md`, Conventions): `io.github.agoradesktop.NAME`.
  Lower case because it is reverse-DNS and Apple's own are (com.apple.finder); the product's spelling lives in
  CFBundleName, which is what a person reads. It was `org.agora.Workspace`, which named an organisation this
  project has no claim on.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.agoradesktop.workspace</string>
	<key>CFBundleName</key>
	<string>Workspace</string>
	<key>CFBundleExecutable</key>
	<string>Workspace</string>
	<!-- **THE ICON IS NAMED AND NOT CARRIED.** Icon Services looks for `Contents/Resources/Workspace.icns` and, when the
	     bundle has none, answers for an application from the theme in charge — which is where a desktop's art belongs
	     now that the default theme is the user's rendered Flat-Remix rather than art this repository vendored. The
	     declaration stays so an installation that drops its own `Workspace.icns` in is read the ordinary way. -->
	<key>CFBundleIconFile</key>
	<string>Workspace</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
</dict>
</plist>
